+def _maybe_load_qsa_static_kv_scales(model: Qwen4ExpModel) -> None:
+    path = (envs.VLLM_QSA_KV_SCALES or "").strip()
+    local_qsa = {
+        layer.layer_name: layer
+        for layer in model.modules()
+        if isinstance(layer, Qwen4ExpQSAAttention)
+    }
+    expected = {
+        f"{model._layer_prefix}.layers.{layer_id}.self_attn.attn"
+        for layer_id in model._qsa_layer_ids
+    }
+    if not expected:
+        if path:
+            raise ValueError(
+                "VLLM_QSA_KV_SCALES is set for a model without QSA layers"
+            )
+        return
+
+    has_fp8_qsa = any(
+        layer.kv_cache_dtype in ("fp8", "fp8_e4m3")
+        for layer in local_qsa.values()
+    )
+    if not path:
+        if has_fp8_qsa:
+            raise ValueError(
+                "Qwen4Exp FP8 QSA requires VLLM_QSA_KV_SCALES pointing to the "
+                "checkpoint qsa_kv_scales_262k.json sidecar"
+            )
+        return
+
+    applied = load_qsa_static_kv_scales(
+        local_qsa,
+        path,
+        expected_layer_names=expected,
+    )
+    logger.info(
+        "Qwen4Exp QSA: validated %d global scale entries; applied %d local entries",
+        len(expected),
+        len(applied),
+    )
+
