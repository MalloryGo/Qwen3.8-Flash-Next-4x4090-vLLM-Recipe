+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import json
+
+import pytest
+import torch
+from torch import nn
+
+from vllm.models.qwen4_exp.nvidia.qsa import (
+    Qwen4ExpQSAAttention,
+    load_qsa_static_kv_scales,
+)
+
+
+def _qsa_layer(name: str) -> Qwen4ExpQSAAttention:
+    layer = Qwen4ExpQSAAttention.__new__(Qwen4ExpQSAAttention)
+    nn.Module.__init__(layer)
+    layer.layer_name = name
+    layer.kv_cache_dtype = "fp8_e4m3"
+    for field in ("_k_scale", "_v_scale"):
+        layer.register_buffer(field, torch.zeros(()))
+    layer._k_scale_cpu = torch.zeros(())
+    layer._v_scale_cpu = torch.zeros(())
+    layer._k_scale_float = 0.0
+    layer._v_scale_float = 0.0
+    return layer
+
+
+def _sidecar() -> dict[str, dict[str, float]]:
+    return {
+        "model.layers.1.self_attn.attn": {"k_scale": 0.25, "v_scale": 0.5},
+        "model.layers.3.self_attn.attn": {"k_scale": 0.75, "v_scale": 1.0},
+    }
+
+
+def test_qsa_scale_sidecar_validates_global_and_applies_local_pp_layers(
+    tmp_path,
+) -> None:
+    path = tmp_path / "qsa_kv_scales_262k.json"
+    path.write_text(json.dumps(_sidecar()), encoding="utf-8")
+    local = {
+        "model.layers.3.self_attn.attn": _qsa_layer(
+            "model.layers.3.self_attn.attn"
+        )
+    }
+
+    applied = load_qsa_static_kv_scales(
+        local,
+        path,
+        expected_layer_names=set(_sidecar()),
+    )
+
+    assert applied == {"model.layers.3.self_attn.attn": (0.75, 1.0)}
+    layer = local["model.layers.3.self_attn.attn"]
+    assert layer._k_scale.item() == 0.75
+    assert layer._v_scale.item() == 1.0
+    assert layer._k_scale_cpu.item() == 0.75
+    assert layer._v_scale_cpu.item() == 1.0
+    assert layer._k_scale_float == 0.75
+    assert layer._v_scale_float == 1.0
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        {"model.layers.1.self_attn.attn": {"k_scale": 0.25, "v_scale": 0.5}},
+        _sidecar()
+        | {"model.layers.5.self_attn.attn": {"k_scale": 1.0, "v_scale": 1.0}},
+        {
+            "model.layers.1.self_attn.attn": {"k_scale": 0.0, "v_scale": 0.5},
+            "model.layers.3.self_attn.attn": {"k_scale": 0.75, "v_scale": 1.0},
+        },
+    ],
+)
+def test_qsa_scale_sidecar_fails_closed_on_invalid_coverage_or_values(
+    tmp_path, payload
+) -> None:
+    path = tmp_path / "qsa_kv_scales_262k.json"
+    path.write_text(json.dumps(payload), encoding="utf-8")
+    local = {
+        "model.layers.3.self_attn.attn": _qsa_layer(
+            "model.layers.3.self_attn.attn"
+        )
+    }
+
+    with pytest.raises(ValueError):
+        load_qsa_static_kv_scales(local, path, set(_sidecar()))
+
+
+def test_qsa_scale_sidecar_rejects_duplicate_layer_keys(tmp_path) -> None:
+    path = tmp_path / "qsa_kv_scales_262k.json"
+    path.write_text(
+        '{"model.layers.1.self_attn.attn":{"k_scale":1,"v_scale":1},'
+        '"model.layers.1.self_attn.attn":{"k_scale":2,"v_scale":2},'
+        '"model.layers.3.self_attn.attn":{"k_scale":1,"v_scale":1}}',
+        encoding="utf-8",
+    )
+    local = {
+        "model.layers.3.self_attn.attn": _qsa_layer(
+            "model.layers.3.self_attn.attn"
+        )
+    }
+
+    with pytest.raises(ValueError, match="Duplicate JSON key"):
+        load_qsa_static_kv_scales(local, path, set(_sidecar()))
+
+
+def test_qsa_scale_sidecar_requires_an_existing_file(tmp_path) -> None:
+    path = tmp_path / "missing-qsa-scales.json"
+    local = {
+        "model.layers.3.self_attn.attn": _qsa_layer(
+            "model.layers.3.self_attn.attn"
+        )
+    }
+
+    with pytest.raises(FileNotFoundError):
+        load_qsa_static_kv_scales(local, path, set(_sidecar()))
