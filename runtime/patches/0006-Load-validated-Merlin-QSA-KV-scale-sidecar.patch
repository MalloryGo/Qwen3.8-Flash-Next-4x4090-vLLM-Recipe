+def load_qsa_static_kv_scales(
+    qsa_layers: Mapping[str, Qwen4ExpQSAAttention],
+    sidecar_path: str | Path,
+    expected_layer_names: set[str],
+) -> dict[str, tuple[float, float]]:
+    """Validate a full-model sidecar and apply only this PP rank's QSA scales."""
+    path = Path(sidecar_path)
+
+    def reject_duplicate_keys(pairs: list[tuple[str, object]]) -> dict[str, object]:
+        result: dict[str, object] = {}
+        for key, value in pairs:
+            if key in result:
+                raise ValueError(f"Duplicate JSON key {key!r} in {path}")
+            result[key] = value
+        return result
+
+    raw = json.loads(
+        path.read_text(encoding="utf-8"), object_pairs_hook=reject_duplicate_keys
+    )
+    if not isinstance(raw, dict):
+        raise ValueError(f"{path} must contain a JSON object keyed by layer name")
+
+    local_names = set(qsa_layers)
+    if not local_names <= expected_layer_names:
+        raise ValueError("Local QSA layers are not a subset of the expected model set")
+    if any(layer.layer_name != name for name, layer in qsa_layers.items()):
+        raise ValueError("QSA layer mapping keys must match each layer's layer_name")
+
+    missing = sorted(expected_layer_names - raw.keys())
+    extra = sorted(raw.keys() - expected_layer_names)
+    if missing or extra:
+        raise ValueError(
+            f"Invalid QSA scale coverage in {path}: missing={missing}, extra={extra}"
+        )
+
+    validated: dict[str, tuple[float, float]] = {}
+    for name in sorted(expected_layer_names):
+        entry = raw[name]
+        if not isinstance(entry, dict) or set(entry) != {"k_scale", "v_scale"}:
+            raise ValueError(f"{name} must contain exactly k_scale and v_scale")
+        scales: list[float] = []
+        for field in ("k_scale", "v_scale"):
+            value = entry[field]
+            if type(value) not in (int, float):
+                raise ValueError(f"{name}.{field} must be a scalar JSON number")
+            scale = float(value)
+            if not math.isfinite(scale) or scale <= 0.0:
+                raise ValueError(f"{name}.{field} must be finite and positive")
+            scales.append(scale)
+        validated[name] = (scales[0], scales[1])
+
+    for name, layer in qsa_layers.items():
+        if layer.kv_cache_dtype not in ("fp8", "fp8_e4m3"):
+            raise ValueError(f"{name} static QSA scales require an FP8 KV cache")
+        for field in ("_k_scale", "_v_scale", "_k_scale_cpu", "_v_scale_cpu"):
+            tensor = getattr(layer, field, None)
+            if not isinstance(tensor, torch.Tensor) or tensor.numel() != 1:
+                raise ValueError(f"{name}.{field} must be an existing scalar tensor")
+            if tensor.device.type == "meta":
+                raise ValueError(f"{name}.{field} is still on the meta device")
+        if (
+            layer._k_scale_cpu.device.type != "cpu"
+            or layer._v_scale_cpu.device.type != "cpu"
+        ):
+            raise ValueError(f"{name} host QSA scales must remain on CPU")
+
+    applied = {name: validated[name] for name in sorted(local_names)}
+    with torch.no_grad():
+        for name, (k_scale, v_scale) in applied.items():
+            layer = qsa_layers[name]
+            layer._k_scale.fill_(k_scale)
+            layer._v_scale.fill_(v_scale)
+            layer._k_scale_cpu.fill_(k_scale)
+            layer._v_scale_cpu.fill_(v_scale)
+            # The QSA Triton path consumes these Python scalars directly.
+            layer._k_scale_float = k_scale
+            layer._v_scale_float = v_scale
+    return applied
+
