---
 tests/models/qwen4_exp/test_config.py | 12 ++++++++++--
 vllm/models/qwen4_exp/nvidia/mtp.py   |  2 +-
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/tests/models/qwen4_exp/test_config.py b/tests/models/qwen4_exp/test_config.py
index 7a634194..1c6506cc 100644
--- a/tests/models/qwen4_exp/test_config.py
+++ b/tests/models/qwen4_exp/test_config.py
@@ -58,6 +58,13 @@ def test_qwen4_exp_mtp_returns_sample_and_multi_streams() -> None:
     model.hc_count = 2
     model.hidden_size = 4
     model.num_mtp_layers = 1
+    model.embed_input_ids = lambda input_ids: (
+        input_ids.to(torch.float32).unsqueeze(-1).expand(-1, 4)
+    )
+    model.pre_fc_norm_embedding = lambda value: value
+    model.fc_embedding = lambda value: value
+    model.pre_fc_norm_hidden = lambda value: value
+    model.fc_hidden = lambda value: value
     model.layers = [
         lambda **kwargs: (
             kwargs["hidden_states"],
@@ -80,9 +87,10 @@ def test_qwen4_exp_mtp_returns_sample_and_multi_streams() -> None:
         return_value=pp_group,
     ):
         sample_hidden, returned_multi_hidden = model.forward(
-            input_ids=None,
+            input_ids=torch.tensor([5, 7]),
             positions=torch.arange(2),
-            intermediate_tensors={"hidden_states": multi_hidden},
+            hidden_states=multi_hidden,
+            intermediate_tensors=None,
         )
 
     torch.testing.assert_close(
