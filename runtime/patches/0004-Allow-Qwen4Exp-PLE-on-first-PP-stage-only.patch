From 310a70e1478db9c990d4a2c488d7e645b8fc5c5f Mon Sep 17 00:00:00 2001
From: Recipe integration <integration@example.org>
Date: Sun, 27 Sep 2026 00:53:30 +0800
Subject: [PATCH 4/7] Allow Qwen4Exp PLE on first PP stage only

---
 tests/models/qwen4_exp/test_config.py       | 17 +++++++++-------
 vllm/model_executor/models/config.py        | 22 +++++++++++++++------
 vllm/models/qwen4_exp/nvidia/model_state.py |  8 --------
 3 files changed, 26 insertions(+), 21 deletions(-)

diff --git a/tests/models/qwen4_exp/test_config.py b/tests/models/qwen4_exp/test_config.py
index 9d30365b..7a634194 100644
--- a/tests/models/qwen4_exp/test_config.py
+++ b/tests/models/qwen4_exp/test_config.py
@@ -140,11 +140,14 @@ def test_qwen4_exp_mtp_override_sets_draft_config(
     assert draft_config.n_predict == 1
 
 
-@pytest.mark.parametrize("ple_layer_ids", [[1], []])
-def test_qwen4_exp_rejects_pipeline_parallel_only_with_ple(ple_layer_ids) -> None:
-    """PLE needs raw input_ids, which non-first pipeline ranks never see. The
-    rest of the architecture is PP-capable, so the refusal must be conditional
-    -- and must land before the engine spends time loading weights."""
+@pytest.mark.parametrize(
+    "ple_layer_ids,should_reject",
+    [([1], False), ([2], True), ([], False)],
+)
+def test_qwen4_exp_pipeline_parallel_requires_ple_on_first_rank(
+    ple_layer_ids, should_reject
+) -> None:
+    """PLE can use PP only when every PLE layer owns first-stage input_ids."""
     vllm_config = SimpleNamespace(
         model_config=SimpleNamespace(
             hf_text_config=_text_config(ple_layer_ids=ple_layer_ids),
@@ -158,8 +161,8 @@ def test_qwen4_exp_rejects_pipeline_parallel_only_with_ple(ple_layer_ids) -> Non
     with patch.object(
         Qwen3_5ForConditionalGenerationConfig, "verify_and_update_config"
     ):
-        if ple_layer_ids:
-            with pytest.raises(NotImplementedError, match="pipeline_parallel_size=1"):
+        if should_reject:
+            with pytest.raises(NotImplementedError, match="pipeline rank 0"):
                 Qwen4ExpForConditionalGenerationConfig.verify_and_update_config(
                     vllm_config
                 )
diff --git a/vllm/model_executor/models/config.py b/vllm/model_executor/models/config.py
index bbbe98bc..364265ae 100644
--- a/vllm/model_executor/models/config.py
+++ b/vllm/model_executor/models/config.py
@@ -874,14 +874,24 @@ class Qwen4ExpForConditionalGenerationConfig(Qwen3_5ForConditionalGenerationConf
             raise NotImplementedError(
                 "Qwen4Exp PLE/QSA does not support dual-batch overlap or microbatching"
             )
-        # Checked again in Qwen4ExpModelState; rejecting it here keeps the
-        # engine from loading weights first.
+        # PLE needs raw input_ids only on the rank that owns its layers. Allow
+        # PP>1 when every PLE layer remains on pipeline rank 0.
         if text_config.ple_layer_ids and parallel_config.pipeline_parallel_size > 1:
-            raise NotImplementedError(
-                "Qwen4Exp N-gram PLE embedding requires pipeline_parallel_size=1 "
-                "because non-first pipeline ranks do not receive the raw input_ids "
-                "it needs. Please run with PP=1."
+            from vllm.distributed.utils import get_pp_indices
+
+            rank0_start, rank0_end = get_pp_indices(
+                int(text_config.num_hidden_layers),
+                0,
+                parallel_config.pipeline_parallel_size,
             )
+            ple_idx = [int(i) - 1 for i in text_config.ple_layer_ids]
+            if min(ple_idx) < rank0_start or max(ple_idx) >= rank0_end:
+                raise NotImplementedError(
+                    "Qwen4Exp N-gram PLE embedding requires every PLE layer to "
+                    f"live on pipeline rank 0 (layers {rank0_start}.."
+                    f"{rank0_end - 1}), but PLE layers are at {ple_idx}. Adjust "
+                    "VLLM_PP_LAYER_PARTITION or use PP=1."
+                )
         multimodal_config = vllm_config.model_config.multimodal_config
         if multimodal_config is not None and multimodal_config.language_model_only:
             _strip_qwen4_exp_mrope(vllm_config.model_config)
diff --git a/vllm/models/qwen4_exp/nvidia/model_state.py b/vllm/models/qwen4_exp/nvidia/model_state.py
index 24616850..4d43cddd 100644
--- a/vllm/models/qwen4_exp/nvidia/model_state.py
+++ b/vllm/models/qwen4_exp/nvidia/model_state.py
@@ -32,14 +32,6 @@ class Qwen4ExpModelState(MambaHybridModelState):
             self.ngram_eos_token_id = 0
             return
 
-        if vllm_config.parallel_config.pipeline_parallel_size > 1:
-            raise RuntimeError(
-                "N-gram PLE embedding currently requires "
-                "pipeline_parallel_size=1 because non-first pipeline ranks do "
-                "not receive the raw input_ids required by PLE. Please run "
-                "with PP=1."
-            )
-
         self.ngram_context_len = int(config.ngram_size) - 1
         if self.ngram_context_len <= 0:
             raise ValueError("N-gram embedding requires context length >= 1.")
